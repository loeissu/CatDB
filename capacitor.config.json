{
  "appId": "com.loeissu.catdb",
  "appName": "豆包喵喵",
  "webDir": "www",
  "server": {
    "androidScheme": "http"
  },
  "plugins": {
    "StatusBar": {
      "style": "dark",
      "backgroundColor": "#5D4037",
      "overlaysWebView": true
    },
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#FFF9F0",
      "showSpinner": false
    }
  },
  "android": {
    "allowMixedContent": true,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  }
}
